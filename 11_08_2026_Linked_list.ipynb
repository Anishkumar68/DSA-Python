   "source": [
    "class Node:\n",
    "\n",
    "    def __init__(self, data):\n",
    "        self.data = data\n",
    "        self.next = None\n",
    "\n",
    "\n",
    "a,b,c  = Node(5),Node(10),Node(20)\n",
    "a.next = b\n",
    "b.next = c   "
   ]
  },
